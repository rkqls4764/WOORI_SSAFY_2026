# 복사해서 .env로 저장. 키가 없으면 대본 모드로 실행됩니다.

# --- A) Ollama(로컬 모델, 키 필요 없음) ---------------------------
LLM_MODE=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# tool calling을 지원하는 모델(ollama.com에서 'Tools' 태그 확인)
LLM_MODEL=qwen3:8b
# Qwen3 계열이면 1: 답변에 생각 과정이 섞이지 않게
LLM_NO_THINK=1

# --- B) 클라우드 API(OpenAI 호환) ----------------------------------
# LLM_MODE=openai
# LLM_BASE_URL=            # OpenAI 본사면 비워 두기, 다른 서비스면 그 주소
# LLM_API_KEY=발급받은 키
# LLM_MODEL=tool calling 지원 모델 이름

# (선택) 견적 1건 비용 계산용 단가: 100만 토큰당 원
LLM_PRICE_IN_KRW_PER_1M=
LLM_PRICE_OUT_KRW_PER_1M=
